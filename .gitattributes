# Pre-registrations and their hash records are verified byte for byte
# (tests/test_preregistrations.py). Line-ending conversion on checkout would change the
# bytes on Windows clones and break every hash, so these files are stored and checked out
# exactly as committed.
research/**/preregs/*.md -text
outputs/research/prereg_*.json -text

# Shell scripts run inside Linux containers and must keep LF endings everywhere.
*.sh text eol=lf
deploy/crontab text eol=lf
