# Secrets - never commit
.env
.env.*
!.env.example

# Local working material - kept out of the repo (notes, drafts, scratch).
_private/

# Local editor and tooling directories - never part of the project
.vscode/
.idea/
.understand-anything/
# The Claude Code desk (CLAUDE.md, .claude/) is shared; personal settings and agent
# worktrees are not.
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/

# Data (raw, processed and cached pulls are git-ignored per the data plan)
data/raw/
data/processed/
data/cache/
*.parquet
# Small test fixtures may be committed when they exist.
!tests/fixtures/**/*.parquet

# Stray run output at the repository root
/*.log
/*.csv
*.bak

# Generated research artefacts (tearsheets, metric dumps).
# Ignore the CONTENTS, not the directory: git does not descend into an excluded
# directory, so a negation under `outputs/` would never be reached.
outputs/*

# One research artefact is published, by name. `fills_rescore.csv` is the three-row
# cost-basis summary that `tests/test_fills_rescore_attainability.py` reads to stop the
# selection-biased execution arm being promoted. Without the file the guard skips, which
# means the single most dangerous number in the project is unguarded in a clone. It holds
# the project's own computed statistics, not vendor rows, so it is publishable.
# Name files individually here. A pattern such as `!outputs/research/*.csv` would publish
# several hundred artefacts, many of them superseded.
!outputs/research/
outputs/research/*
!outputs/research/fills_rescore.csv
# The pre-registration hash records: the project's own declarations (trial id, date,
# SHA-256 of the frozen text), checked against research/*/preregs by the test suite.
!outputs/research/prereg_*.json
# Their run logs (timestamp, event and scorer SHA-256 only), which the same test reads to check
# that a pinned scorer is the code that produced the outcomes.
!outputs/research/prereg_*.runs.jsonl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
build/
dist/
.coverage
htmlcov/

# LaTeX intermediates anywhere
*.aux
*.synctex.gz

# LaTeX build artefacts (the compiled PDF is kept; intermediates are not)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# OS / editor
.DS_Store
Thumbs.db

# Office temp/lock files
~$*

# Research paper drafts: kept local, not published.
/paper/

# Cloud paper-book deployment: credentials and VM state stay on the VM.
deploy/*.env
deploy/state/
ivcrush_deploy.tar.gz
