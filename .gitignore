# Secrets - never commit
.env
.env.*
!.env.example

# Local working material - kept out of the repo (notes, drafts, scratch).
_private/

# Local editor and tooling directories - never part of the project
.vscode/
.idea/
.claude/
.understand-anything/
CLAUDE.md

# Data (raw and processed pulls are git-ignored per the data plan)
data/raw/
data/processed/
*.parquet

# Generated research artefacts (tearsheets, metric dumps).
# Ignore the CONTENTS, not the directory: git does not descend into an excluded
# directory, so a negation under `outputs/` would never be reached.
outputs/*
# The forward paper book is the record itself and must persist. The cloud recorder
# commits it back after every run; while it was ignored, `git add` failed and the job
# pushed nothing whilst still reporting success.
!outputs/paper/
outputs/paper/*
!outputs/paper/*.csv

# One research artefact is published, by name. `fills_rescore.csv` is the three-row
# cost-basis summary that `tests/test_fills_rescore_attainability.py` reads to stop the
# selection-biased execution arm being promoted. Without the file the guard skips, which
# means the single most dangerous number in the project is unguarded in a clone. It holds
# the project's own computed statistics, not vendor rows, so it is publishable.
# Name files individually here. A pattern such as `!outputs/research/*.csv` would publish
# several hundred artefacts, many of them superseded.
!outputs/research/
outputs/research/*
!outputs/research/fills_rescore.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# LaTeX build artefacts (the compiled PDF is kept; intermediates are not)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# OS / editor
.DS_Store
Thumbs.db

# Office temp/lock files
~$*

# Research paper drafts: kept local, not published.
# Root-anchored: an unanchored `paper/` matches at any depth and would also swallow
# outputs/paper/, the forward book.
/paper/
