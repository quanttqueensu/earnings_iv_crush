# Copy this file to .env and fill in your values.
# .env is git-ignored: never commit real keys.
#
# Several sources work with no key at all (FRED VIX via the public CSV
# endpoint, yfinance equities and option chains). The keys below unlock the
# higher-quality or rate-limited providers.

SEC_USER_AGENT=      # required for SEC EDGAR, format: "Name email@example.com"
FINNHUB_API_KEY=     # earnings calendar
TIINGO_API_KEY=      # equity OHLCV (yfinance is the keyless fallback)
FRED_API_KEY=        # VIX series (the public CSV endpoint also works keyless)
ALPACA_KEY=          # historical option surfaces (Alpaca free, since ~Feb 2024)
ALPACA_SECRET=       # pairs with ALPACA_KEY
DATABENTO_API_KEY=   # OPRA historical options: consolidated quotes (the marking basis) and daily bars, back to 2013. Metered.

# WRDS mirror on Cloudflare R2 (S3-compatible, read-only). Supplies the Compustat/IBES
# earnings calendar and CRSP equity spot. Read by data/wrds_r2.py; the mirror holds no
# OptionMetrics, so option marks still come from Databento.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=     # account-specific S3 endpoint
R2_BUCKET=           # defaults to the shared historical-market-data bucket

# Team-data bucket on the same R2 account: the research caches listed in data/MANIFEST.csv,
# fetched with `python -m earnings_iv_crush.data.sync pull`. Ask the team lead for the values.
# Endpoint and keys fall back to the R2_* values above when these are left empty; uploading
# (`sync push`) needs a key with write access.
IVCRUSH_R2_BUCKET=
IVCRUSH_R2_PREFIX=earnings_iv_crush
IVCRUSH_R2_ENDPOINT_URL=
IVCRUSH_R2_ACCESS_KEY_ID=
IVCRUSH_R2_SECRET_ACCESS_KEY=

# IBKR paper book (earnings_iv_crush/live/): no key. TWS or IB Gateway must be running on a
# paper port with the API enabled; defaults live in LiveConfig in earnings_iv_crush/config.py.
IB_PORT=                 # 7497 TWS paper (default), 4002 Gateway paper
IB_MARKET_DATA_TYPE=     # 4 delayed (default); 1 once the OPRA real-time subscription exists
MAX_NAMES_PER_DAY=       # shakedown default 3 (docs/decisions/0005-shakedown-limits.md)

# Research switch, not a secret. Leave unset. IVCRUSH_MARK=raw disables the no-arbitrage
# repair in earnings_iv_crush/research/market_marks.py and exists only to reproduce the
# unrepaired book.
IVCRUSH_MARK=
