# crontab -- install on the VM with `crontab deploy/crontab` (as the deploy user).
# The VM clock is set to America/New_York (see README), so these times are
# exchange time and follow daylight saving automatically.
#
# 14:00, 14:30, 15:00 and 15:10 ET Mon-Fri: confirm the gateway is logged in,
# restarting it if not. IBKR drops the session around 00:15 ET and refuses the
# automatic re-login most nights, so a restart is needed most days; four attempts
# leave room for one to fail. Nothing runs after 15:10, so a restart can never
# land inside the 15:45-15:59 order ladder.
0,30 14 * * 1-5 /opt/ivcrush/deploy/gateway_preflight.sh >> /opt/ivcrush/deploy/state/control/cron.log 2>&1
0,10 15 * * 1-5 /opt/ivcrush/deploy/gateway_preflight.sh >> /opt/ivcrush/deploy/state/control/cron.log 2>&1

# 15:20 ET Mon-Fri: the daily pass; its order ladder runs 15:45-15:59 inside it.
# Holidays and early closes are filtered inside the container by session_check.py.
20 15 * * 1-5 cd /opt/ivcrush/deploy && /usr/bin/docker compose --profile run run --rm runner >> state/control/cron.log 2>&1

# 18:00 ET Sunday: prune build cache and dangling images so the boot volume
# does not fill over months of rebuilds.
0 18 * * 0 /usr/bin/docker system prune -f >> /opt/ivcrush/deploy/state/control/cron.log 2>&1
