# runner.env -- copy to deploy/runner.env on the VM only (chmod 600). Never commit.
FINNHUB_API_KEY=
# Ping URL from healthchecks.io (free tier); leave empty to disable alerting.
HEALTHCHECK_URL=

# Book definition. The broad universe is the 346-name population on which the
# unconditional baseline was measured; session-aware timing gives the one-session
# hold the backtest scores.
SELECTION_RULE=unconditional
UNIVERSE_PATH=data/universe_broad.csv
SESSION_AWARE_TIMING=true
# 4 = delayed-frozen (works without a subscription); 1 = real-time once OPRA is
# subscribed on the funded login and shared to the paper account.
IB_MARKET_DATA_TYPE=4
